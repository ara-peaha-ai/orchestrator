# Required: shared with the operator tools and n8n (openssl rand -hex 32). Empty = every route answers 401.
NUXT_RISK_SECRET=""
# Required: private JSON with rails and rules per use case (shape: use-cases.example.json)
NUXT_RISK_USE_CASES_FILE=""
# Downloaded images, deleted with the profile
NUXT_RISK_WORK_DIR="/tmp/risk"
# Netscape cookies.txt of the dedicated logged-in account (Instagram + TikTok)
NUXT_RISK_COOKIES_FILE=""
# Paid Monid fallback when gallery-dl / yt-dlp are blocked (needs `monid` logged in on the host)
NUXT_RISK_MONID_FALLBACK="false"
NUXT_RISK_SIGHTENGINE_USER=""
NUXT_RISK_SIGHTENGINE_SECRET=""
# dont-trust-verify standalone URL (…/api/dont-trust-verify) and its NUXT_DONT_TRUST_VERIFY_PROXY_SECRET
NUXT_RISK_DONT_TRUST_VERIFY_URL=""
NUXT_RISK_DONT_TRUST_VERIFY_SECRET=""
NUXT_RISK_MEMPOOL_URL="https://mempool.space/api"
