# One file for every service: the root app embeds them all as modules (nuxt.config.js).
# cp .env.example .env and fill in. A service running standalone reads the same names from its own .env.

# --- services/ip
NUXT_IP_DETECTION_CLOUDFLARE_SECRET="set this in your Cloudflare Transform Rule as x-cf-origin-token header value"
NUXT_IP_DETECTION_COUNTRY="false"
NUXT_IP_DETECTION_CURRENCY="true"
NUXT_IP_DETECTION_RATE_LIMIT="100"
NUXT_IP_DETECTION_LIMIT_PATHS=""
NUXT_IPINFO_API_KEY="optional — enables IPinfo fallback (free lifetime key at ipinfo.io)"

# --- services/tor
NUXT_TOR_PROXY_SECRET="a long random secret key"
NUXT_TOR_SOCKS_URL="optional, defaults to socks5h://127.0.0.1:9050"

# --- services/market
NUXT_ROBOSATS_COORDINATOR_ONION_URL='http://otmoonrndnrddqdlhu6b36heunmbyw3cgvadqo2oqeau3656wfv7fwad.onion'

# --- rails/robosats
NUXT_ROBOSATS_COORDINATOR_URL='http://otmoonrndnrddqdlhu6b36heunmbyw3cgvadqo2oqeau3656wfv7fwad.onion'

# --- rails/peach
NUXT_PEACH_BASE_URL='https://api.peachbitcoin.com'
NUXT_PEACH_BITCOIN_MNEMONIC='your twelve word bip39 mnemonic phrase here'
NUXT_PEACH_PGP_PRIVATE_KEY='-----BEGIN PGP PRIVATE KEY BLOCK-----...'
NUXT_PEACH_PGP_PUBLIC_KEY='-----BEGIN PGP PUBLIC KEY BLOCK-----...'
NUXT_PEACH_PGP_PASSPHRASE='your pgp passphrase'
NUXT_PEACH_REFERRAL_CODE=''
NUXT_PEACH_FEE_RATE='hourFee'
NUXT_PEACH_MAX_PREMIUM='0'

# --- rails/masspay
NUXT_MASSPAY_BASE_URL='https://api.masspay.io/v1.0.0'
NUXT_MASSPAY_API_KEY='your masspay sandbox api key'
NUXT_MASSPAY_WEBHOOK_SECRET='your masspay webhook signing secret (from the client dashboard API section)'
NUXT_MASSPAY_BENEFICIARY_USER_TOKEN='usr_...  (the user_token receiving the PYG payout)'
NUXT_MASSPAY_DESTINATION_TOKEN='dst_...  (MassPay -> Paraguay -> Bank Deposit -> SIPAP, from CatalogService.getCountryServices)'
NUXT_MASSPAY_ATTR_SET_TOKEN='attr_set_...  (beneficiary bank account attrs stored via AttributeService.storeAttrs for the destination above)'
NUXT_MASSPAY_SOURCE_CURRENCY='USD'

# --- services/dont-trust-verify
NUXT_DONT_TRUST_VERIFY_MIN_AGE="18"
NUXT_DONT_TRUST_VERIFY_MATCH_THRESHOLD="0.6"
# Standalone only: generate a long random value (openssl rand -hex 32). Empty = x-user-id is never trusted.
NUXT_DONT_TRUST_VERIFY_PROXY_SECRET=""
# Free key: https://www.chainalysis.com/free-cryptocurrency-sanctions-screening-tools/ Empty = /sanctions answers 503.
NUXT_DONT_TRUST_VERIFY_CHAINALYSIS_API_KEY=""

# --- services/risk
# Required: shared with the operator tools and n8n (openssl rand -hex 32). Empty = every route answers 401.
NUXT_RISK_SECRET=""
# Required: private JSON with rails and rules per use case (shape: use-cases.example.json)
NUXT_RISK_USE_CASES_FILE=""
# Downloaded images, deleted with the profile
NUXT_RISK_WORK_DIR="/tmp/risk"
# Netscape cookies.txt of the dedicated logged-in account (Instagram + TikTok)
NUXT_RISK_COOKIES_FILE=""
# Paid Monid fallback when gallery-dl / yt-dlp are blocked (needs `monid` logged in on the host)
NUXT_RISK_MONID_FALLBACK="false"
NUXT_RISK_SIGHTENGINE_USER=""
NUXT_RISK_SIGHTENGINE_SECRET=""
# dont-trust-verify standalone URL (…/api/dont-trust-verify) and its NUXT_DONT_TRUST_VERIFY_PROXY_SECRET
NUXT_RISK_DONT_TRUST_VERIFY_URL=""
NUXT_RISK_DONT_TRUST_VERIFY_SECRET=""
NUXT_RISK_MEMPOOL_URL="https://mempool.space/api"

# --- services/cors (standalone Cloudflare Worker only, not embedded in the root app)
NUXT_CORS_TARGET_URL='the api you want to proxy in the format https://api.example.com'
NUXT_CORS_PROXY_SECRET='a long random secret key'
NUXT_CORS_HEALTH_PATH='the endpoint path to check for health of the target api, default is /'
