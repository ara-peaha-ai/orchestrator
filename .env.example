# One file for every service the root app embeds as a module (nuxt.config.js); cors runs standalone only.
# cp .env.example .env and fill in. A service running standalone reads the same names from its own .env.
# Values are empty or the real default: instructions live on the comment line above, never inside the quotes.

# --- services/ip
# Value your Cloudflare Transform Rule sends as the x-cf-origin-token header. Empty = Cloudflare headers are trusted as is.
NUXT_IP_DETECTION_CLOUDFLARE_SECRET=""
NUXT_IP_DETECTION_COUNTRY="false"
NUXT_IP_DETECTION_CURRENCY="true"
NUXT_IP_DETECTION_RATE_LIMIT="100"
# Comma-separated path prefixes to rate-limit; empty = the built-in list
NUXT_IP_DETECTION_LIMIT_PATHS=""
# Optional IPinfo fallback (free lifetime key at ipinfo.io); empty = off
NUXT_IPINFO_API_KEY=""

# --- services/tor
# Long random value (openssl rand -hex 32), sent by callers as X-Tor-Proxy-Secret. Empty = the proxy denies every call.
NUXT_TOR_PROXY_SECRET=""
# Uncomment to change the default socks5h://127.0.0.1:9050
# NUXT_TOR_SOCKS_URL=""

# --- services/market
# RoboSats coordinator for the market tor-proxy route; uncomment to change the RoboSats default onion
# NUXT_ROBOSATS_COORDINATOR_ONION_URL=""

# --- rails/robosats
NUXT_ROBOSATS_COORDINATOR_URL='http://otmoonrndnrddqdlhu6b36heunmbyw3cgvadqo2oqeau3656wfv7fwad.onion'

# --- rails/peach
NUXT_PEACH_BASE_URL='https://api.peachbitcoin.com'
# 12-word BIP39 mnemonic of the Peach account
NUXT_PEACH_BITCOIN_MNEMONIC=''
# Armored PGP keys of the Peach account, on one line with \n
NUXT_PEACH_PGP_PRIVATE_KEY=''
NUXT_PEACH_PGP_PUBLIC_KEY=''
NUXT_PEACH_PGP_PASSPHRASE=''
NUXT_PEACH_REFERRAL_CODE=''
NUXT_PEACH_FEE_RATE='hourFee'
NUXT_PEACH_MAX_PREMIUM='0'

# --- rails/masspay
NUXT_MASSPAY_BASE_URL='https://api.masspay.io/v1.0.0'
NUXT_MASSPAY_API_KEY=''
# Webhook signing secret, from the client dashboard API section
NUXT_MASSPAY_WEBHOOK_SECRET=''
# usr_... : the user_token receiving the PYG payout
NUXT_MASSPAY_BENEFICIARY_USER_TOKEN=''
# dst_... : MassPay -> Paraguay -> Bank Deposit -> SIPAP, from CatalogService.getCountryServices
NUXT_MASSPAY_DESTINATION_TOKEN=''
# attr_set_... : beneficiary bank account attrs stored via AttributeService.storeAttrs for the destination above
NUXT_MASSPAY_ATTR_SET_TOKEN=''
NUXT_MASSPAY_SOURCE_CURRENCY='USD'

# --- services/btcpay
NUXT_BTCPAY_URL=''
# Server-side API key
NUXT_BTCPAY_API_KEY=''
NUXT_BTCPAY_STORE_ID=''
# Webhook HMAC secret
NUXT_BTCPAY_WEBHOOK_SECRET=''
# Expected in the x-btcpay-admin-secret header; empty = every /admin route is denied
NUXT_BTCPAY_ADMIN_SECRET=''
# Optional CSS applied to POS apps
NUXT_BTCPAY_POS_CSS_URL=''

# --- services/dont-trust-verify
NUXT_DONT_TRUST_VERIFY_MIN_AGE="18"
NUXT_DONT_TRUST_VERIFY_MATCH_THRESHOLD="0.6"
# Standalone only: generate a long random value (openssl rand -hex 32). Empty = x-user-id is never trusted.
NUXT_DONT_TRUST_VERIFY_PROXY_SECRET=""
# Free key: https://www.chainalysis.com/free-cryptocurrency-sanctions-screening-tools/ Empty = /sanctions answers 503.
NUXT_DONT_TRUST_VERIFY_CHAINALYSIS_API_KEY=""

# --- services/risk
# Required: shared with the operator tools and n8n (openssl rand -hex 32). Empty = every operator route answers 401;
# the consent page the subject opens stays unauthenticated by design and stores only the first click.
NUXT_RISK_SECRET=""
# Required: private JSON with rails and rules per use case (shape: use-cases.example.json)
NUXT_RISK_USE_CASES_FILE=""
# Downloaded images, default /tmp/risk. On a shared host uncomment and use a private 0700 directory outside /tmp.
# Files are removed when the operator deletes the profile.
# NUXT_RISK_WORK_DIR=""
# Netscape cookies.txt of the dedicated logged-in account (Instagram + TikTok)
NUXT_RISK_COOKIES_FILE=""
# Paid Monid fallback when gallery-dl / yt-dlp are blocked (needs `monid` logged in on the host)
NUXT_RISK_MONID_FALLBACK="false"
NUXT_RISK_SIGHTENGINE_USER=""
NUXT_RISK_SIGHTENGINE_SECRET=""
# dont-trust-verify standalone URL (…/api/dont-trust-verify) and its NUXT_DONT_TRUST_VERIFY_PROXY_SECRET
NUXT_RISK_DONT_TRUST_VERIFY_URL=""
NUXT_RISK_DONT_TRUST_VERIFY_SECRET=""
NUXT_RISK_MEMPOOL_URL="https://mempool.space/api"

# --- services/cors (standalone Cloudflare Worker only, not embedded in the root app)
# API to proxy, e.g. https://api.example.com
NUXT_CORS_TARGET_URL=''
# Long random value sent as x-cors-secret. Empty = the proxy denies every call.
NUXT_CORS_PROXY_SECRET=''
# Health-check path on the target; uncomment to change the default /
# NUXT_CORS_HEALTH_PATH=
